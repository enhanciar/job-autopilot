# Copy to .env and fill. Never commit .env.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://localhost:11434
# Google OAuth (Gmail + Sheets + Drive) client json path
GOOGLE_CLIENT_SECRET_FILE=./data/google_client_secret.json
GOOGLE_SHEET_ID=
# Optional: attach automation to your running Chrome (reuses logged-in sessions). Start Chrome with --remote-debugging-port=9222
CHROME_CDP_URL=
